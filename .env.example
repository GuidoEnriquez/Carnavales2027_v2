# Shared environment template. Never commit real values in .env files.

# API / PostgreSQL (required from T04 onward; copy API values to api/.env)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/carnavales2027_v2
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/carnavales2027_v2_test
# DB_POOL_MAX=10

# Better Auth (required from T06 onward; copy API values to api/.env)
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# BETTER_AUTH_URL=http://localhost:3000

# Client (required when API integration starts)
# VITE_API_URL=http://localhost:3000

# Production-only one-time administrator bootstrap (T09)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Initial Admin
# BOOTSTRAP_ADMIN_PASSWORD=set-outside-version-control

# Development/test ADMIN seed (T10; never use in production)
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_NAME=Development Admin
# SEED_ADMIN_PASSWORD=set-outside-version-control
