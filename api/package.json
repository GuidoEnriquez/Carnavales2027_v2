{
  "name": "carnavales2027-v2-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "node --import=dotenv/config src/scripts/assert-test-database-url.js",
    "test": "node --import=dotenv/config --test --test-concurrency=1",
    "db:migrate": "node src/db/migrate.js",
    "auth:migrate": "npx auth@1.6.27 migrate --config src/auth/auth.js --yes",
    "bootstrap:admin": "node src/scripts/bootstrap-admin.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:goya": "node src/scripts/seed-goya-2027.js",
    "db:seed:test": "node src/scripts/seed-test-prueba.js",
    "db:seed:penalties": "node src/scripts/seed-penalties-demo.js",
    "db:seed:fiction": "node src/scripts/seed-fiction-contest.js",
    "predb:test": "node --import=dotenv/config src/scripts/assert-test-database-url.js",
    "db:test": "node --import=dotenv/config --test src/db/tests/**/*.test.js"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.16.3"
  }
}
