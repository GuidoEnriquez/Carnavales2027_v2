{
  "name": "carnavales2027-v2-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "node --import=dotenv/config src/scripts/assert-test-database-url.js",
    "test": "node --import=dotenv/config --test --test-concurrency=1 src/tests/*.test.js src/db/tests/*.test.js src/modules/results/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "auth:migrate": "npx auth@1.6.27 migrate --config src/auth/auth.js --yes",
    "bootstrap:admin": "node src/scripts/bootstrap-admin.js",
    "seed:event:full": "node src/scripts/seed-full-event.js",
    "predb:test": "node --import=dotenv/config src/scripts/assert-test-database-url.js",
    "db:test": "node --import=dotenv/config --test src/db/tests/*.test.js",
    "audit:verify": "node src/scripts/verify-audit-chain.js"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.16.3"
  }
}
