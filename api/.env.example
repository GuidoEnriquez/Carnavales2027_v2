# Copiar como .env solo para desarrollo local. Nunca versionar valores reales.

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/carnavales2027_v2
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/carnavales2027_v2_test
DB_POOL_MAX=10

# Better Auth (required from T06 onward)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
EMAIL_PROVIDER=console
# EMAIL_FROM=noreply@example.test
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-me
# SMTP_PASSWORD=replace-me

# Production-only one-time administrator bootstrap (T09)
# Execute only after `npm run auth:migrate` and `npm run db:migrate`.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Initial Admin
# BOOTSTRAP_ADMIN_PASSWORD=set-outside-version-control
